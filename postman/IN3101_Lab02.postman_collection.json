    {
      "name": "00 Setup - send both requests before S1",
      "description": "On a new lab database, create these two books first. Then S1 creates the third book. Do not capture these helper requests as numbered submission evidence.",
      "item": [
        {
          "name": "Seed book 2 - Effective Java",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Effective Java\",\n  \"author\": \"Joshua Bloch\",\n  \"isbn\": \"9780134685991\",\n  \"price\": 5200.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Seed book 3 - Design Patterns",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Design Patterns\",\n  \"author\": \"Erich Gamma et al.\",\n  \"isbn\": \"9780201633610\",\n  \"price\": 6100.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "S1 Create a book - 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books",
        "description": "Capture the whole Postman window with the JSON request body, URL, status and response id visible. The returned id is saved as bookId for S3-S6.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"234202J - Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"9780132350884\",\n  \"price\": 4500.0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"bookId\", pm.response.json().id);",
              "pm.test(\"Generated id\", function () { pm.expect(pm.response.json().id).to.be.a(\"number\").above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "S2 List all books - 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books",
        "description": "Ensure setup requests have run. Capture at least three complete book entries including the index-number title."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"At least three books including 234202J\", function () { const books = pm.response.json(); pm.expect(books.length).to.be.at.least(3); pm.expect(books.some(b => b.title.includes(\"234202J\"))).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "S3 Get one book - 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Correct id\", function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"bookId\"))); });"
            ]
          }
        }
      ]
    },
    {
