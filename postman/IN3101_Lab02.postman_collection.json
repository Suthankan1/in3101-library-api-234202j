        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"234202J - Clean Code (Updated)\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"9780132350884\",\n  \"price\": 4750.0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Updated title and price\", function () { const b = pm.response.json(); pm.expect(b.title).to.eql(\"234202J - Clean Code (Updated)\"); pm.expect(b.price).to.eql(4750); });"
            ]
          }
        }
      ]
    },
